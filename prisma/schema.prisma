generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  institution String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  experiments Experiment[]
  boms        Bom[]

  @@map("users")
}

model Experiment {
  id               String           @id @default(cuid())
  name             String
  description      String
  status           ExperimentStatus @default(submitted)
  estimatedCostUSD Float
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            Item[]

  @@map("experiments")
}

model Item {
  id               String     @id @default(cuid())
  name             String
  quantity         Int
  unit             String
  estimatedCostUSD Float?
  supplier         String?
  catalog          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  experimentId     String
  experiment       Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@map("items")
}

model Bom {
  id        String   @id @default(cuid())
  email     String
  csv       String   // Raw CSV data
  status    BomStatus @default(pending)
  result    Json?    // Structured result from OpenAI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("boms")
}

enum ExperimentStatus {
  submitted
  analyzing
  completed
  failed
}

enum BomStatus {
  pending
  processing
  completed
  failed
}
